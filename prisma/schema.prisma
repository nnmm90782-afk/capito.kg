  changedBy      String?        @map("changed_by") @db.Uuid
  comment        String?
  createdAt      DateTime       @default(now()) @map("created_at")

  delivery Delivery @relation(fields: [deliveryId], references: [id])

  @@map("delivery_status_history")
}

