  moderatedBy String?      @map("moderated_by") @db.Uuid
  moderatedAt DateTime?    @map("moderated_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  user        User              @relation(fields: [userId], references: [id])
  order       Order?            @relation(fields: [orderId], references: [id])
  branch      Branch            @relation(fields: [branchId], references: [id])
  replies     ReviewReply[]
  aiAnalysis  ReviewAiAnalysis?
  topicLinks  ReviewTopicLink[]

  @@unique([userId, orderId])
  @@map("reviews")
}

model ReviewReply {
  id        String   @id @default(uuid()) @db.Uuid
  reviewId  String   @map("review_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  text      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  review Review @relation(fields: [reviewId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@map("review_replies")
}

model ReviewAiAnalysis {
  id          String        @id @default(uuid()) @db.Uuid
  reviewId    String        @unique @map("review_id") @db.Uuid
  sentiment   SentimentType
  summary     String?
  model       String        @db.VarChar(100)
  processedAt DateTime      @map("processed_at")

  review Review @relation(fields: [reviewId], references: [id])

  @@map("review_ai_analysis")
}

model ReviewTopic {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(50)
  name String @db.VarChar(100)

  topicLinks ReviewTopicLink[]

  @@map("review_topics")
}

model ReviewTopicLink {
  reviewId   String  @map("review_id") @db.Uuid
  topicId    String  @map("topic_id") @db.Uuid
  confidence Decimal @db.Decimal(5, 4)

  review Review      @relation(fields: [reviewId], references: [id])
  topic  ReviewTopic @relation(fields: [topicId], references: [id])

  @@id([reviewId, topicId])
  @@map("review_topic_links")
}

// =============================================================================
// NOTIFICATIONS
// =============================================================================

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(255)
  body      String
  data      Json?
  orderId   String?          @map("order_id") @db.Uuid
  bookingId String?          @map("booking_id") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at")

  user      User                     @relation(fields: [userId], references: [id])
  order     Order?                   @relation(fields: [orderId], references: [id])
  booking   Booking?                 @relation(fields: [bookingId], references: [id])
  deliveries NotificationDelivery[]

  @@map("notifications")
}

model NotificationDelivery {
  id                String                     @id @default(uuid()) @db.Uuid
  notificationId    String                     @map("notification_id") @db.Uuid
  channel           NotificationChannel
  status            NotificationDeliveryStatus @default(PENDING)
  providerMessageId String?                    @map("provider_message_id") @db.VarChar(255)
  sentAt            DateTime?                  @map("sent_at")
  deliveredAt       DateTime?                  @map("delivered_at")
  readAt            DateTime?                  @map("read_at")
  errorMessage      String?                    @map("error_message")

  notification Notification @relation(fields: [notificationId], references: [id])

  @@map("notification_deliveries")
}

model PushSubscription {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  endpoint   String
  p256dh     String
  auth       String
  deviceType DeviceType? @map("device_type")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id])

  @@map("push_subscriptions")
}

model NotificationPreference {
  id               String              @id @default(uuid()) @db.Uuid
  userId           String              @map("user_id") @db.Uuid
  channel          NotificationChannel
  notificationType NotificationType    @map("notification_type")
  enabled          Boolean             @default(true)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, channel, notificationType])
  @@map("notification_preferences")
}

// =============================================================================
// TELEGRAM
// =============================================================================

model TelegramAccount {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  telegramUserId BigInt   @unique @map("telegram_user_id")
  username       String?  @db.VarChar(255)
  firstName      String?  @map("first_name") @db.VarChar(255)
  lastName       String?  @map("last_name") @db.VarChar(255)
  chatId         BigInt   @map("chat_id")
  isActive       Boolean  @default(true) @map("is_active")
  linkedAt       DateTime @default(now()) @map("linked_at")
  createdAt      DateTime @default(now()) @map("created_at")

  user   User            @relation(fields: [userId], references: [id])
  events TelegramEvent[]

  @@map("telegram_accounts")
}

model TelegramEvent {
  id                String   @id @default(uuid()) @db.Uuid
  telegramAccountId String   @map("telegram_account_id") @db.Uuid
  updateId          BigInt   @unique @map("update_id")
  eventType         String   @map("event_type") @db.VarChar(100)
  payload           Json
  processedAt       DateTime? @map("processed_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  telegramAccount TelegramAccount @relation(fields: [telegramAccountId], references: [id])

  @@map("telegram_events")
}

// =============================================================================
// QR CODES
// =============================================================================

model QrCode {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique @db.VarChar(100)
  type        QrCodeType
  targetUrl   String?   @map("target_url")
  branchId    String?   @map("branch_id") @db.Uuid
  tableId     String?   @map("table_id") @db.Uuid
  promotionId String?   @map("promotion_id") @db.Uuid
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")

  branch Branch?          @relation(fields: [branchId], references: [id])
  table  RestaurantTable? @relation(fields: [tableId], references: [id])
  orders Order[]

  @@map("qr_codes")
}

// =============================================================================
// INVENTORY
// =============================================================================

model Warehouse {
  id       String        @id @default(uuid()) @db.Uuid
  branchId String        @map("branch_id") @db.Uuid
  name     String        @db.VarChar(150)
  type     WarehouseType @default(MAIN)
  isActive Boolean       @default(true) @map("is_active")

  branch          Branch           @relation(fields: [branchId], references: [id])
  inventoryItems  InventoryItem[]
  stockMovements  StockMovement[]
  stockTransfersFrom StockTransfer[] @relation("FromWarehouse")
  stockTransfersTo   StockTransfer[] @relation("ToWarehouse")
  purchaseOrders  PurchaseOrder[]

  @@map("warehouses")
}

model InventoryItem {
  id              String  @id @default(uuid()) @db.Uuid
  warehouseId     String  @map("warehouse_id") @db.Uuid
  ingredientId    String  @map("ingredient_id") @db.Uuid
  quantity        Decimal @db.Decimal(14, 4)
  reservedQuantity Decimal @default(0) @map("reserved_quantity") @db.Decimal(14, 4)
  minimumQuantity Decimal? @map("minimum_quantity") @db.Decimal(14, 4)
  maximumQuantity Decimal? @map("maximum_quantity") @db.Decimal(14, 4)
  updatedAt       DateTime @updatedAt @map("updated_at")

  warehouse  Warehouse  @relation(fields: [warehouseId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([warehouseId, ingredientId])
  @@map("inventory_items")
}

model Supplier {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @db.VarChar(255)
  phone    String? @db.VarChar(30)
  email    String? @db.VarChar(255)
  address  String?
  taxId    String? @map("tax_id") @db.VarChar(100)
  isActive Boolean @default(true) @map("is_active")

  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model PurchaseOrder {
  id          String              @id @default(uuid()) @db.Uuid
  supplierId  String              @map("supplier_id") @db.Uuid
  warehouseId String              @map("warehouse_id") @db.Uuid
  number      String              @unique @db.VarChar(50)
  status      PurchaseOrderStatus @default(DRAFT)
  totalAmount Decimal             @map("total_amount") @db.Decimal(12, 2)
  orderedAt   DateTime?           @map("ordered_at")
  receivedAt  DateTime?           @map("received_at")

  supplier  Supplier           @relation(fields: [supplierId], references: [id])
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id])
  items     PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(uuid()) @db.Uuid
  purchaseOrderId String  @map("purchase_order_id") @db.Uuid
  ingredientId    String  @map("ingredient_id") @db.Uuid
  quantity        Decimal @db.Decimal(14, 4)
  unitPrice       Decimal @map("unit_price") @db.Decimal(12, 2)
  totalPrice      Decimal @map("total_price") @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  ingredient    Ingredient    @relation(fields: [ingredientId], references: [id])

  @@map("purchase_order_items")
}

model StockMovement {
  id             String            @id @default(uuid()) @db.Uuid
  warehouseId    String            @map("warehouse_id") @db.Uuid
  ingredientId   String            @map("ingredient_id") @db.Uuid
  type           StockMovementType
  quantity       Decimal           @db.Decimal(14, 4)
  quantityBefore Decimal           @map("quantity_before") @db.Decimal(14, 4)
  quantityAfter  Decimal           @map("quantity_after") @db.Decimal(14, 4)
  referenceType  String?           @map("reference_type") @db.VarChar(50)
  referenceId    String?           @map("reference_id") @db.Uuid
  createdBy      String?           @map("created_by") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at")

  warehouse  Warehouse  @relation(fields: [warehouseId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@map("stock_movements")
}

model StockTransfer {
  id              String   @id @default(uuid()) @db.Uuid
  fromWarehouseId String   @map("from_warehouse_id") @db.Uuid
  toWarehouseId   String   @map("to_warehouse_id") @db.Uuid
  status          String   @default("pending") @db.VarChar(30)
  createdBy       String?  @map("created_by") @db.Uuid
  approvedBy      String?  @map("approved_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  completedAt     DateTime? @map("completed_at")

  fromWarehouse Warehouse @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse @relation("ToWarehouse", fields: [toWarehouseId], references: [id])

  @@map("stock_transfers")
}

// =============================================================================
// AI
// =============================================================================

model UserProductPreference {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  score     Decimal  @db.Decimal(8, 4)
  source    String   @db.VarChar(50)
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@map("user_product_preferences")
}

model AiConversation {
  id        String                @id @default(uuid()) @db.Uuid
  userId    String                @map("user_id") @db.Uuid
  channel   AiConversationChannel
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")

  user     User        @relation(fields: [userId], references: [id])
  messages AiMessage[]

  @@map("ai_conversations")
}

model AiMessage {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @map("conversation_id") @db.Uuid
  role           AiMessageRole
  content        String
  metadata       Json?
  model          String?       @db.VarChar(100)
  createdAt      DateTime      @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id])

  @@map("ai_messages")
}

model AiGeneratedContent {
  id               String          @id @default(uuid()) @db.Uuid
  type             String          @db.VarChar(50)
  prompt           String
  generatedContent String          @map("generated_content")
  model            String          @db.VarChar(100)
  status           AiContentStatus @default(DRAFT)
  createdBy        String?         @map("created_by") @db.Uuid
  approvedBy       String?         @map("approved_by") @db.Uuid
  approvedAt       DateTime?       @map("approved_at")
  createdAt        DateTime        @default(now()) @map("created_at")

  @@map("ai_generated_contents")
}

// =============================================================================
// ANALYTICS
// =============================================================================

model AnalyticsSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  deviceType DeviceType? @map("device_type")
  browser   String?   @db.VarChar(100)
  os        String?   @db.VarChar(100)
  source    String?   @db.VarChar(100)
  campaign  String?   @db.VarChar(100)
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("analytics_sessions")
}

model AnalyticsEvent {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  sessionId  String?  @map("session_id") @db.Uuid
  eventName  String   @map("event_name") @db.VarChar(100)
  entityType String?  @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.Uuid
  branchId   String?  @map("branch_id") @db.Uuid
  orderId    String?  @map("order_id") @db.Uuid
  properties Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user   User?   @relation(fields: [userId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])
  order  Order?  @relation(fields: [orderId], references: [id])

  @@map("analytics_events")
}

model MarketingCampaign {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  source    String?  @db.VarChar(100)
  medium    String?  @db.VarChar(100)
  campaign  String?  @db.VarChar(150)
  content   String?  @db.VarChar(150)
  term      String?  @db.VarChar(150)
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  user User? @relation(fields: [createdBy], references: [id])

  @@map("marketing_campaigns")
}

// =============================================================================
// SYSTEM
// =============================================================================

model SystemSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(150)
  value       Json
  type        String   @db.VarChar(30)
  description String?
  isPublic    Boolean  @default(false) @map("is_public")
  updatedBy   String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.Uuid
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model ScheduledJob {
  id          String             @id @default(uuid()) @db.Uuid
  jobType     String             @map("job_type") @db.VarChar(100)
  status      ScheduledJobStatus @default(PENDING)
  payload     Json?
  attempts    Int                @default(0)
  lastError   String?            @map("last_error")
  runAt       DateTime           @map("run_at")
  completedAt DateTime?          @map("completed_at")
  createdAt   DateTime           @default(now()) @map("created_at")

  @@map("scheduled_jobs")
}
