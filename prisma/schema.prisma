// =============================================================================
// ORDERS
// =============================================================================

model Order {
  id                 String        @id @default(uuid()) @db.Uuid
  orderNumber        String        @unique @map("order_number") @db.VarChar(30)
  userId             String        @map("user_id") @db.Uuid
  branchId           String        @map("branch_id") @db.Uuid
  tableId            String?       @map("table_id") @db.Uuid
  qrCodeId           String?       @map("qr_code_id") @db.Uuid
  type               OrderType
  status             OrderStatus   @default(NEW)
  paymentStatus      PaymentStatus @default(PENDING) @map("payment_status")
  subtotal           Decimal       @db.Decimal(12, 2)
  discountAmount     Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  bonusAmount        Decimal       @default(0) @map("bonus_amount") @db.Decimal(12, 2)
  deliveryFee        Decimal       @default(0) @map("delivery_fee") @db.Decimal(12, 2)
  totalAmount        Decimal       @map("total_amount") @db.Decimal(12, 2)
  promoCode          String?       @map("promo_code") @db.VarChar(100)
  comment            String?
  customerName       String?       @map("customer_name") @db.VarChar(255)
  customerPhone      String?       @map("customer_phone") @db.VarChar(30)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  completedAt        DateTime?     @map("completed_at")
  cancelledAt        DateTime?     @map("cancelled_at")
  cancellationReason String?       @map("cancellation_reason")

  user              User                @relation(fields: [userId], references: [id])
  branch            Branch              @relation(fields: [branchId], references: [id])
  table             RestaurantTable?    @relation(fields: [tableId], references: [id])
  qrCode            QrCode?             @relation(fields: [qrCodeId], references: [id])
  items             OrderItem[]
  statusHistory     OrderStatusHistory[]
  cancellation      OrderCancellation?
  payments          Payment[]
  delivery          Delivery?
  kitchenOrders     KitchenOrder[]
  bonusTransactions BonusTransaction[]
  promoUsages       PromoUsage[]
  reviews           Review[]
  notifications     Notification[]
  refunds           Refund[]
  analyticsEvents   AnalyticsEvent[]

  @@map("orders")
}

model OrderItem {
  id               String  @id @default(uuid()) @db.Uuid
  orderId          String  @map("order_id") @db.Uuid
  productId        String  @map("product_id") @db.Uuid
  productVariantId String  @map("product_variant_id") @db.Uuid
  productName      String  @map("product_name") @db.VarChar(255)
  variantName      String  @map("variant_name") @db.VarChar(100)
  quantity         Int
  unitPrice        Decimal @map("unit_price") @db.Decimal(12, 2)
  discountAmount   Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalPrice       Decimal @map("total_price") @db.Decimal(12, 2)
  comment          String?

  order          Order               @relation(fields: [orderId], references: [id])
  productVariant ProductVariant      @relation(fields: [productVariantId], references: [id])
  modifiers      OrderItemModifier[]
  refundItems    RefundItem[]

  @@map("order_items")
}

model OrderItemModifier {
  id            String  @id @default(uuid()) @db.Uuid
  orderItemId   String  @map("order_item_id") @db.Uuid
  modifierId    String  @map("modifier_id") @db.Uuid
  modifierName  String  @map("modifier_name") @db.VarChar(150)
  quantity      Int     @default(1)
  unitPrice     Decimal @map("unit_price") @db.Decimal(12, 2)
  totalPrice    Decimal @map("total_price") @db.Decimal(12, 2)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  modifier  Modifier  @relation(fields: [modifierId], references: [id])

  @@map("order_item_modifiers")
}

model OrderStatusHistory {
  id               String      @id @default(uuid()) @db.Uuid
  orderId          String      @map("order_id") @db.Uuid
  status           OrderStatus
  previousStatus   OrderStatus? @map("previous_status")
  changedByUserId  String?      @map("changed_by_user_id") @db.Uuid
  comment          String?
  createdAt        DateTime    @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])

  @@map("order_status_history")
}

model OrderCancellation {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @unique @map("order_id") @db.Uuid
  cancelledBy String? @map("cancelled_by") @db.Uuid
  reasonCode String?  @map("reason_code") @db.VarChar(50)
  reasonText String?  @map("reason_text")
  createdAt  DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])

  @@map("order_cancellations")
}

