// =============================================================================
// Capito Coffee — Prisma Schema
// =============================================================================
// Domains:
//   AUTH · BRANCHES · CATALOG · CART · ORDERS · PAYMENTS · DELIVERY
//   BOOKING · LOYALTY · MARKETING · CONTENT · REVIEWS · NOTIFICATIONS
//   TELEGRAM · QR · INVENTORY · AI · ANALYTICS · SYSTEM
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum DeviceType {
  MOBILE
  DESKTOP
  TABLET
}

enum OrderType {
  DELIVERY
  PICKUP
  DINE_IN
}

enum OrderStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  COURIER_ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  MBANK
  ELSOM
  OPTIMA
  CASH
  OTHER
}

enum PaymentMethod {
  CARD
  CASH
  BONUS
  QR
  OTHER
}

enum TransactionType {
  AUTHORIZE
  CAPTURE
  REFUND
  VOID
}

enum DeliveryStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  COURIER_ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum BonusTransactionType {
  EARN
  SPEND
  REFUND
  EXPIRE
  ADJUSTMENT
  BONUS
}

enum PromoCodeType {
  PERCENT
  FIXED
}

enum PromotionType {
  DISCOUNT
  GIFT
  BUY_X_GET_Y
  PROMO_CODE
  SEASONAL
  BRANCH
  BONUS
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  INACTIVE
  EXPIRED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  DELETED
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
  DELETED
}

enum NotificationType {
  ORDER_ACCEPTED
  ORDER_PREPARING
  ORDER_READY
  COURIER_ASSIGNED
  ORDER_IN_TRANSIT
  ORDER_DELIVERED
  BOOKING_CONFIRMED
  PROMOTION
  PROMO_CODE
  BONUS
  PERSONAL_OFFER
}

enum NotificationChannel {
  PUSH
  TELEGRAM
  EMAIL
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum WarehouseType {
  MAIN
  COLD
  DRY
  BAR
}

enum StockMovementType {
  RECEIPT
  SALE
  WRITE_OFF
  TRANSFER
  RETURN
  ADJUSTMENT
}

enum TransportType {
  FOOT
  BICYCLE
  MOTORCYCLE
  CAR
}

enum CourierStatus {
  AVAILABLE
  BUSY
  OFFLINE
}

enum SentimentType {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum AiContentStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum QrCodeType {
  MENU
  ORDER
  PWA
  BRANCH
  PROMOTION
  TABLE
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
}

enum ScheduledJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AiConversationChannel {
  WEB
  TELEGRAM
  PWA
}

// =============================================================================
// AUTH / USERS
// =============================================================================

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String?   @unique @db.VarChar(255)
  phone              String?   @unique @db.VarChar(30)
  passwordHash       String?   @map("password_hash")
  firstName          String?   @map("first_name") @db.VarChar(100)
  lastName           String?   @map("last_name") @db.VarChar(100)
  avatarUrl          String?   @map("avatar_url")
  dateOfBirth        DateTime? @map("date_of_birth") @db.Date
  gender             String?   @db.VarChar(30)
  status             UserStatus @default(ACTIVE)
  emailVerifiedAt    DateTime? @map("email_verified_at")
  phoneVerifiedAt    DateTime? @map("phone_verified_at")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  authAccounts           UserAuthAccount[]
  sessions               UserSession[]
  userRoles              UserRole[]
  employee               Employee?
  addresses              UserAddress[]
  favorites              Favorite[]
  carts                  Cart[]
  orders                 Order[]
  bookings               Booking[]
  bonusAccount           BonusAccount?
  promoUsages            PromoUsage[]
  reviews                Review[]
  reviewReplies          ReviewReply[]
  notifications          Notification[]
  pushSubscriptions      PushSubscription[]
  notificationPreferences NotificationPreference[]
  telegramAccount        TelegramAccount?
  productPreferences     UserProductPreference[]
  aiConversations        AiConversation[]
  auditLogs              AuditLog[]
  analyticsEvents        AnalyticsEvent[]
  analyticsSessions      AnalyticsSession[]
  marketingCampaigns     MarketingCampaign[]

  @@map("users")
}

model UserAuthAccount {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  provider       String   @db.VarChar(30)
  providerUserId String   @map("provider_user_id") @db.VarChar(255)
  providerEmail  String?  @map("provider_email") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerUserId])
  @@map("user_auth_accounts")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  deviceName       String?   @map("device_name") @db.VarChar(255)
  deviceType       DeviceType? @map("device_type")
  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("user_sessions")
}

// =============================================================================
// RBAC
// =============================================================================

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  code        String   @unique @db.VarChar(100)
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(150)
  name        String  @db.VarChar(150)
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String?  @map("assigned_by") @db.Uuid

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

// =============================================================================
// EMPLOYEES
// =============================================================================

model Employee {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  employeeNumber    String?   @map("employee_number") @db.VarChar(50)
  position          String?   @db.VarChar(100)
  hireDate          DateTime? @map("hire_date") @db.Date
  terminationDate   DateTime? @map("termination_date") @db.Date
  status            String    @default("active") @db.VarChar(30)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user             User               @relation(fields: [userId], references: [id])
  employeeBranches EmployeeBranch[]
  courier          Courier?

  @@map("employees")
}

model EmployeeBranch {
  id         String    @id @default(uuid()) @db.Uuid
  employeeId String    @map("employee_id") @db.Uuid
  branchId   String    @map("branch_id") @db.Uuid
  isPrimary  Boolean   @default(false) @map("is_primary")
  startedAt  DateTime  @default(now()) @map("started_at")
  endedAt    DateTime? @map("ended_at")

  employee Employee @relation(fields: [employeeId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])

  @@map("employee_branches")
}

// =============================================================================
// BRANCHES
// =============================================================================

model Branch {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  code        String?  @unique @db.VarChar(50)
  address     String
  city        String   @default("Bishkek") @db.VarChar(100)
  district    String?  @db.VarChar(150)
  phone       String?  @db.VarChar(30)
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  is24_7      Boolean  @default(false) @map("is_24_7")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  schedules        BranchSchedule[]
  holidays         BranchHoliday[]
  branchFeatures   BranchFeature[]
  employeeBranches EmployeeBranch[]
  branchProducts   BranchProduct[]
  branchMedia      BranchMedia[]
  carts            Cart[]
  orders           Order[]
  bookings         Booking[]
  bookingZones     BookingZone[]
  restaurantTables RestaurantTable[]
  deliveries       Delivery[]
  deliveryZones    DeliveryZone[]
  kitchenOrders    KitchenOrder[]
  kitchenStations  KitchenStation[]
  warehouses       Warehouse[]
  qrCodes          QrCode[]
  promotions       PromotionBranch[]
  promoCodeBranches PromoCodeBranch[]
  reviews          Review[]
  analyticsEvents  AnalyticsEvent[]

  @@map("branches")
}

model BranchSchedule {
  id         String   @id @default(uuid()) @db.Uuid
  branchId   String   @map("branch_id") @db.Uuid
  dayOfWeek  Int      @map("day_of_week") @db.SmallInt
  openTime   DateTime @map("open_time") @db.Time
  closeTime  DateTime @map("close_time") @db.Time
  isClosed   Boolean  @default(false) @map("is_closed")

  branch Branch @relation(fields: [branchId], references: [id])

  @@map("branch_schedules")
}

model BranchHoliday {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  date      DateTime @db.Date
  isClosed  Boolean  @default(true) @map("is_closed")
  openTime  DateTime? @map("open_time") @db.Time
  closeTime DateTime? @map("close_time") @db.Time
  reason    String?  @db.VarChar(255)

  branch Branch @relation(fields: [branchId], references: [id])

  @@map("branch_holidays")
}

model Feature {
  id   String  @id @default(uuid()) @db.Uuid
  code String  @unique @db.VarChar(100)
  name String  @db.VarChar(150)
  icon String? @db.VarChar(100)

  branchFeatures BranchFeature[]

  @@map("features")
}

model BranchFeature {
  branchId  String @map("branch_id") @db.Uuid
  featureId String @map("feature_id") @db.Uuid

  branch  Branch  @relation(fields: [branchId], references: [id])
  feature Feature @relation(fields: [featureId], references: [id])

  @@id([branchId, featureId])
  @@map("branch_features")
}

// =============================================================================
// MEDIA
// =============================================================================

model MediaFile {
  id          String   @id @default(uuid()) @db.Uuid
  storageKey  String   @map("storage_key")
  url         String
  fileName    String   @map("file_name") @db.VarChar(255)
  mimeType    String   @map("mime_type") @db.VarChar(100)
  fileSize    BigInt   @map("file_size")
  width       Int?
  height      Int?
  altText     String?  @map("alt_text")
  createdAt   DateTime @default(now()) @map("created_at")

  productMedia   ProductMedia[]
  branchMedia    BranchMedia[]
  newsMedia      NewsMedia[]
  promotionMedia PromotionMedia[]
  documents      Document[]
  newsOgImage    News[]           @relation("OgImageRelation")
  seoMetadata    SeoMetadata[]

  @@map("media_files")
}

model ProductMedia {
  productId   String @map("product_id") @db.Uuid
  mediaFileId String @map("media_file_id") @db.Uuid
  sortOrder   Int    @default(0) @map("sort_order")
  isMain      Boolean @default(false) @map("is_main")

  product   Product   @relation(fields: [productId], references: [id])
  mediaFile MediaFile @relation(fields: [mediaFileId], references: [id])

  @@id([productId, mediaFileId])
  @@map("product_media")
}

model BranchMedia {
  branchId    String @map("branch_id") @db.Uuid
  mediaFileId String @map("media_file_id") @db.Uuid
  sortOrder   Int    @default(0) @map("sort_order")
  isMain      Boolean @default(false) @map("is_main")

  branch    Branch    @relation(fields: [branchId], references: [id])
  mediaFile MediaFile @relation(fields: [mediaFileId], references: [id])

  @@id([branchId, mediaFileId])
  @@map("branch_media")
}

model NewsMedia {
  newsId      String @map("news_id") @db.Uuid
  mediaFileId String @map("media_file_id") @db.Uuid
  sortOrder   Int    @default(0) @map("sort_order")

  news      News      @relation(fields: [newsId], references: [id])
  mediaFile MediaFile @relation(fields: [mediaFileId], references: [id])

  @@id([newsId, mediaFileId])
  @@map("news_media")
}

model PromotionMedia {
  promotionId String @map("promotion_id") @db.Uuid
  mediaFileId String @map("media_file_id") @db.Uuid
  sortOrder   Int    @default(0) @map("sort_order")

  promotion Promotion @relation(fields: [promotionId], references: [id])
  mediaFile MediaFile @relation(fields: [mediaFileId], references: [id])

  @@id([promotionId, mediaFileId])
  @@map("promotion_media")
}

model Document {
  id          String   @id @default(uuid()) @db.Uuid
  type        String   @db.VarChar(50)
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    String   @map("entity_id") @db.Uuid
  mediaFileId String   @map("media_file_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  mediaFile MediaFile @relation(fields: [mediaFileId], references: [id])

  @@map("documents")
}

// =============================================================================
// CATALOG
// =============================================================================

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  parentId    String?   @map("parent_id") @db.Uuid
  name        String    @db.VarChar(150)
  slug        String    @unique @db.VarChar(200)
  description String?
  sortOrder   Int       @default(0) @map("sort_order")
  imageId     String?   @map("image_id") @db.Uuid
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryParent")
  products Product[]
  promoCodeCategories PromoCodeCategory[]

  @@map("categories")
}

model Product {
  id               String    @id @default(uuid()) @db.Uuid
  categoryId       String    @map("category_id") @db.Uuid
  name             String    @db.VarChar(255)
  slug             String    @unique @db.VarChar(255)
  description      String?
  shortDescription String?   @map("short_description")
  composition      String?
  calories         Int?
  isActive         Boolean   @default(true) @map("is_active")
  isFeatured       Boolean   @default(false) @map("is_featured")
  sortOrder        Int       @default(0) @map("sort_order")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  category             Category              @relation(fields: [categoryId], references: [id])
  variants             ProductVariant[]
  productMedia         ProductMedia[]
  allergens            ProductAllergen[]
  modifierGroups       ProductModifierGroup[]
  branchProducts       BranchProduct[]
  favorites            Favorite[]
  userProductPreferences UserProductPreference[]
  promoCodeProducts    PromoCodeProduct[]

  @@map("products")
}

model ProductVariant {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  name        String   @db.VarChar(100)
  sku         String?  @unique @db.VarChar(100)
  barcode     String?  @db.VarChar(100)
  sizeValue   Decimal? @map("size_value") @db.Decimal(10, 2)
  sizeUnit    String?  @map("size_unit") @db.VarChar(20)
  price       Decimal  @db.Decimal(12, 2)
  costPrice   Decimal? @map("cost_price") @db.Decimal(12, 2)
  calories    Int?
  isDefault   Boolean  @default(false) @map("is_default")
  isActive    Boolean  @default(true) @map("is_active")

  product                  Product                  @relation(fields: [productId], references: [id])
  productIngredients       ProductIngredient[]
  branchProductVariants    BranchProductVariant[]
  cartItems                CartItem[]
  orderItems               OrderItem[]

  @@map("product_variants")
}

model BranchProduct {
  id            String    @id @default(uuid()) @db.Uuid
  branchId      String    @map("branch_id") @db.Uuid
  productId     String    @map("product_id") @db.Uuid
  isAvailable   Boolean   @default(true) @map("is_available")
  priceOverride Decimal?  @map("price_override") @db.Decimal(12, 2)
  availableFrom DateTime? @map("available_from")
  availableTo   DateTime? @map("available_to")

  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([branchId, productId])
  @@map("branch_products")
}

model BranchProductVariant {
  id               String  @id @default(uuid()) @db.Uuid
  branchId         String  @map("branch_id") @db.Uuid
  productVariantId String  @map("product_variant_id") @db.Uuid
  price            Decimal @db.Decimal(12, 2)
  isAvailable      Boolean @default(true) @map("is_available")

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@unique([branchId, productVariantId])
  @@map("branch_product_variants")
}

model Allergen {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(50)
  name        String  @db.VarChar(100)
  description String?

  productAllergens ProductAllergen[]

  @@map("allergens")
}

model ProductAllergen {
  productId  String @map("product_id") @db.Uuid
  allergenId String @map("allergen_id") @db.Uuid

  product  Product  @relation(fields: [productId], references: [id])
  allergen Allergen @relation(fields: [allergenId], references: [id])

  @@id([productId, allergenId])
  @@map("product_allergens")
}

model Ingredient {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(255)
  sku         String? @unique @db.VarChar(100)
  unit        String  @db.VarChar(30)
  description String?
  isActive    Boolean @default(true) @map("is_active")

  productIngredients ProductIngredient[]
  inventoryItems     InventoryItem[]
  stockMovements     StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]

  @@map("ingredients")
}

model ProductIngredient {
  id               String  @id @default(uuid()) @db.Uuid
  productVariantId String  @map("product_variant_id") @db.Uuid
  ingredientId     String  @map("ingredient_id") @db.Uuid
  quantity         Decimal @db.Decimal(12, 4)
  unit             String  @db.VarChar(30)

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  ingredient     Ingredient     @relation(fields: [ingredientId], references: [id])

  @@map("product_ingredients")
}

model ModifierGroup {
  id         String  @id @default(uuid()) @db.Uuid
  name       String  @db.VarChar(150)
  minSelect  Int     @default(0) @map("min_select")
  maxSelect  Int     @default(1) @map("max_select")
  isRequired Boolean @default(false) @map("is_required")

  modifiers             Modifier[]
  productModifierGroups ProductModifierGroup[]

  @@map("modifier_groups")
}

model Modifier {
  id       String  @id @default(uuid()) @db.Uuid
  groupId  String  @map("group_id") @db.Uuid
  name     String  @db.VarChar(150)
  price    Decimal @default(0) @db.Decimal(12, 2)
  isActive Boolean @default(true) @map("is_active")

  group              ModifierGroup        @relation(fields: [groupId], references: [id])
  cartItemModifiers  CartItemModifier[]
  orderItemModifiers OrderItemModifier[]

  @@map("modifiers")
}

model ProductModifierGroup {
  productId       String @map("product_id") @db.Uuid
  modifierGroupId String @map("modifier_group_id") @db.Uuid

  product       Product       @relation(fields: [productId], references: [id])
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id])

  @@id([productId, modifierGroupId])
  @@map("product_modifier_groups")
}

// =============================================================================
// CUSTOMERS
// =============================================================================

model UserAddress {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  label       String?  @db.VarChar(50)
  city        String?  @db.VarChar(100)
  addressLine String   @map("address_line")
  building    String?  @db.VarChar(50)
  apartment   String?  @db.VarChar(50)
  entrance    String?  @db.VarChar(20)
  floor       String?  @db.VarChar(20)
  intercom    String?  @db.VarChar(50)
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)
  comment     String?
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id])
  deliveries Delivery[]

  @@map("user_addresses")
}

model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@map("favorites")
}

// =============================================================================
// CART
// =============================================================================

model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  branchId  String?  @map("branch_id") @db.Uuid
  type      OrderType @default(DELIVERY)
  status    String   @default("active") @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id])
